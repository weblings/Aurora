{
  "name": "aurora-browser-check",
  "private": true,
  "type": "module",
  "description": "Playwright checks that drive Aurora's web screens against the fake-Hue stack. Developer and gate tool, not part of any build.",
  "scripts": {
    "graph-editor": "node checks/graph-editor-edit-loop.mjs",
    "graph-editor:add-node": "node checks/graph-editor-add-node.mjs",
    "graph-editor:save-as-new": "node checks/graph-editor-save-as-new.mjs",
    "graph-editor:port-types": "node checks/graph-editor-port-types.mjs",
    "graph-editor:title-menu": "node checks/graph-editor-title-menu.mjs",
    "graph-editor:top-bar": "node checks/graph-editor-top-bar.mjs",
    "graph-editor:test-outcome": "node checks/graph-editor-test-outcome.mjs",
    "graph-editor:back-link": "node checks/graph-editor-back-link.mjs",
    "graph-editor:control-count": "node checks/graph-editor-control-count.mjs",
    "graph-editor:gate": "node checks/graph-editor-gate.mjs",
    "effect-panel": "node checks/effect-panel.mjs",
    "graph-editor:slow": "SLOW=1 node checks/graph-editor-edit-loop.mjs"
  },
  "dependencies": {
    "playwright-core": "1.54.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}

{
  "name": "aurora-graph-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Aurora node-graph editor (React Flow); built by CMake when AURORA_ENABLE_GRAPH_EDITOR is ON.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "grille": "node ../../tools/grille/switch.mjs",
    "test": "vitest run",
    "build:recipes": "vite build --config vite.recipes.config.ts",
    "dev:recipes": "vite --config vite.recipes.config.ts --open /recipes.html"
  },
  "dependencies": {
    "@weblings_things/grille": "https://github.com/weblings/GrilleDS/releases/download/v0.2.2-dev.1/weblings_things-grille-0.2.2-dev.1.tgz",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.10"
  }
}

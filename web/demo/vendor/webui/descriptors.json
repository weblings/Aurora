      "description": "Stop and Quit"
    },
    {
      "key": "audio.bounceSmoothTime",
      "kind": "slider",
      "description": "Bounce reaction speed",
      "param": {
        "label": "Bounce smooth time",
        "min": 0.05,
        "max": 2.0,
        "step": 0.01,
        "unit": "s",
        "default": 0.285,
        "allowsUnset": false
      }
    },
    {
      "key": "audio.brightnessFloor",
      "kind": "slider",
      "description": "Darkest output when quiet",
      "param": {
        "label": "Brightness floor",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "unit": "",
        "default": 0.4,
        "allowsUnset": false
      }
    },
    {
      "key": "audio.brightnessSmoothTime",
      "kind": "slider",
      "description": "Brightness reaction speed",
      "param": {
        "label": "Brightness smooth time",
        "min": 0.05,
        "max": 2.0,
        "step": 0.01,
        "unit": "s",
        "default": 0.265,
        "allowsUnset": false
      }
    },
    {
      "key": "audio.centroidRangeHz",

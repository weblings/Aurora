<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened-runtime entitlements for Aurora.app (Aurora-qy5.2).
         Only what was shown to be needed; keep this list minimal. Not sandboxed,
         no JIT, no mic (Mac audio input does not exist yet), so nothing is needed.

         disable-library-validation was removed once the Homebrew dylibs were
         bundled and signed with the app under one Developer ID Team ID, so
         library validation passes without it (Aurora-qy5.6.4). Do not add it
         back for an ad-hoc or mixed-Team-ID bundle: sign them consistently. -->
</dict>
</plist>
